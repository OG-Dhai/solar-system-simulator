{
  "name": "solar-system-simulation",
  "version": "2.1.0",
  "description": "3D solar system simulation with Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "npx serve -l 5173 dist",
    "test": "vitest run",
    "test:ui": "playwright test -c tests/utils/headless-setup/playwright.config.js --ui",
    "test:unit": "vitest",
    "lint": "eslint js/**/*.js",
    "test:e2e": "playwright test -c tests/utils/headless-setup/playwright.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.0.0",
    "jsdom": "^27.4.0",
    "serve": "^14.2.0",
    "sharp": "^0.33.5",
    "terser": "^5.46.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "solar-system",
    "three.js",
    "3d",
    "simulation",
    "astronomy",
    "orbital-mechanics",
    "kepler"
  ],
  "author": "Solar System Simulation"
}
